{
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Write",
      "Edit",
      "Bash(vp *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(tr *)",
      "Bash(xargs *)",
      "Bash(jq *)",
      "Bash(curl *)",
      "Bash(npm *)",
      "Bash(tar *)",
      "mcp__chrome-devtools__evaluate_script",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__get_console_message",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__click",
      "mcp__chrome-devtools__type_text",
      "mcp__chrome-devtools__press_key",
      "mcp__chrome-devtools__wait_for",
      "Bash(node_modules/.bin/tsc *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "vp exec bin/beans prime" }]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{ "type": "command", "command": "vp exec bin/beans prime" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -q '\\.agents/docs/' && vp exec qmd update && vp exec qmd embed 2>/dev/null || true",
            "async": true,
            "statusMessage": "Updating qmd agent-docs index..."
          }
        ]
      }
    ]
  }
}
